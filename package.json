{
	"name": "cloudy-shop",
	"version": "0.0.1",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"git:local": "read -p 'Суть коммита: ' COMMIT; git add . ; git commit -am $COMMIT",
		"git:remote": "git push origin functions",
		"git": "npm run git:local && npm run git:remote",
		"ydb:start": "./scripts/ydb-start.sh ram",
		"ydb:stop": "./scripts/ydb-stop.sh",
		"upload:delivery": "npm run build && ./scripts/upload.sh delivery",
		"upload:notification": "npm run build && ./scripts/upload.sh notification",
		"upload:telegram": "npm run build && ./scripts/upload.sh telegram",
		"upload:stocks": "npm run build && ./scripts/upload.sh stocks",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "export YM_API_KEY=`cat .env | egrep -o 'ACMA.*$'` && export OAUTH_TOKEN=`cat .env | egrep -o 'y0_.*$'` && export YC_DB_PATH=`cat .env | egrep -o '/ru-central.*$'` && export YC_DB_ENDPOINT=`cat .env | egrep -o 'grpc.*$'` && vitest",
		"test:session": "npx ts-node scripts/session.ts",
		"test": "npm run test:unit -- --run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/adapter-node": "^5.4.0",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/package": "^2.5.4",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@types/jest": "^30.0.0",
		"jest": "^30.2.0",
		"publint": "^0.3.13",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"ts-jest": "^29.4.5",
		"typescript": "^5.9.2",
		"vite": "^7.1.7",
		"vitest": "^3.2.4"
	},
	"keywords": [
		"svelte"
	],
	"dependencies": {
		"@ydbjs/core": "^6.0.4",
		"@ydbjs/query": "^6.0.4",
		"axios": "^1.12.2",
		"dotenv": "^17.2.3",
		"showdown": "^2.1.0",
		"telegraf": "^4.16.3",
		"ydb-sdk": "^5.11.1"
	}
}
